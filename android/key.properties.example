# Copy to android/key.properties (ignored by git) and fill in.
# The keystore must live OUTSIDE the repository.
#
# Create one (once) with the JDK that ships with Android Studio:
#   keytool -genkeypair -keystore <path>/dino_english_upload.jks \
#     -storetype PKCS12 -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# This is the UPLOAD key for Google Play App Signing: keep a backup of the
# .jks file and of these values in a safe place (password manager).
storePassword=<keystore password>
keyPassword=<key password>
keyAlias=upload
storeFile=<absolute path>/dino_english_upload.jks
